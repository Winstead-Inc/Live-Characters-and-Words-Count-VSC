{
    "name": "live-characters-and-words-count",
    "displayName": "Live Characters & Words Count",
    "description": "Counts word and characters as you type in editor.",
    "version": "1.0.3",
    "author": "Winstead, .Inc",
    "license": "GPL-3.0",
    "repository":
    {
        "type": "git",
        "url": "https://github.com/FranciscoJRFreitas/words-and-chars-count"
    },
    "icon": "icon.png",
    "engines": { "vscode": "^1.60.0" },
    "categories": ["Other"],
    "activationEvents": ["*"],
    "main": "./out/extension.js",
    "contributes":
    {
        "commands":
        [
            { "command": "word-count.show", "title": "Word Count: Show" },
            { "command": "word-count.hide", "title": "Word Count: Hide" }
        ]
    },
    "scripts":
    {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "postcompile": "node scripts/format-lafs.js",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint . --ext .ts",
        "test": "vscode-test"
    },
    "devDependencies":
    {
        "@types/glob": "^7.1.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "14.x",
        "@types/vscode": "^1.60.0",
        "glob": "^7.1.7",
        "typescript": "^4.3.2"
    },
    "publisher": "Winstead-Inc"
}
